# Copy this file to .env and fill in real values before running the backend.

# MongoDB connection string. For fully local/independent operation, install
# MongoDB Community Server and leave this pointing at localhost.
MONGO_URI=mongodb://localhost:27017/farmsathi

# Secret used to sign JWTs. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the ai-service FastAPI process (see ai-service/README.md).
AI_SERVICE_URL=http://localhost:8001

# Port the Express server listens on.
PORT=5000

# When true, OTPs are printed to the server console and returned in the
# /api/login response instead of being sent via SMS. This is what makes the
# app runnable with zero paid third-party services. Set to false only once
# a real SMS provider is wired into backend/controllers/authController.js.
DEV_MODE=true

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:5173
